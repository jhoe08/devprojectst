<div class="table-responsive">
    <table id="transactions-datatables" class="display table table-striped table-hover">
        <thead>
            <tr>
                <% headers.forEach(function(header) { %>
                    <th><%= header %></th>
                <% }); %>
            </tr>
        </thead>
        <tbody>
        <!-- Data will be populated here via DataTables -->
        <% if (lists.length > 0) { 
            lists.forEach(function(item) { 
                if (item.archive !== 1) { %>
                    <tr>
                    <td><%= item.supplier_code %></td>
                    <td><%= item.supplier_name %></td>
                    <td><%= item.supplier_tin %></td>
                    <td><%= item.contact_person %></td> 
                    <td><a href="tel:<%= item.phone %>"><%= item.phone %></a></td>
                    <td><a href="mailto:<%= item.email %>"><%= item.email %></a></td>
                    <td><%= item.address %></td>
                    <td>
                        <a href="/suppliers/<%= item.id %>/view" class="btn btn-link btn-primary">
                        <i class="fa fa-eye"></i>
                        </a>
                        <% if (isSuperAdmin()) { %>
                        <a id="alert_<%=item.id%>" 
                            class="alert_danger btn btn-link btn-danger" 
                            data-path="/suppliers" 
                            data-name="<%= item.supplier_name %>" 
                            data-id="<%= item.id %>">
                            <i class="fa fa-trash"></i>
                        </a>
                        <% } %>
                    </td>
                    </tr>
        <%     } // end archive check
            }); 
            } else { %>
            <tr>
            <td colspan="8" class="text-center">No suppliers found.</td>
            </tr>
        <% } %>
        </tbody>

    </table>
</div>


