<div class="modal fade" id="fundsChargeToModal" tabindex="-1" aria-labelledby="fundsChargeToModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="fundsChargeToModalLabel">Funds Allocations: </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group form-group-default form-group-select">
                    <label for="paps">FUND + PAPs</label>
                    <select name="paps" id="paps" class="form-select"></select>
                </div>
                <div class="form-group form-group-default form-group-select">
                    <label for="class-obj-desc">CLASS + OBJ CODE + DESCRIPTION</label>
                    <select name="class_obj_desc" id="class-obj-desc" class="form-select"></select>
                </div>
                <div class="form-group form-group-default form-group-select">
                    <label for="source">SOURCE</label>
                    <select name="source" id="source" class="form-select" disabled></select>
                </div>
                <div class="form-group form-group-default">
                    <label for="budget">Amount to Charge</label>
                    <div class="input-group ">
                        <span class="input-group-text">₱</span>
                        <input id="amountToCharge" name="amountToCharge" data-type="number" type="text" class="form-control mt-0 text-end" value="0">
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button id="saveFundsChargedTo" type="button" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </div>
</div>