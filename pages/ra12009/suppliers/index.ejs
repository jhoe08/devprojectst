<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="card-head-row card-tools-still-right">
                    <div class="card-title"><%=title%></div>
                    <div class="card-tools">
                        <a href="/suppliers/new" class="btn btn-primary btn-round btn-sm">
                            <span class="btn-label">
                                <i class="fas fa-plus"></i>
                            </span>
                            Add New
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <%- include('../../../components/datatables/supplier', { headers: ["Code", "Name" , "Phone" , "Email"
                    , "Address" , "Actions" ], lists: SUPPLIERS }) -%>
            </div>
        </div>
    </div>
</div>