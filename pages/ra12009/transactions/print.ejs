html, body, #print-area, table {
  break-before: avoid !important;
  break-after: avoid !important;
  break-inside: avoid !important;
  page-break-inside: avoid !important;
  page-break-before: avoid !important;
}
.page-break {
    page-break-before: always !important;
}

/* avoid leaving large blank space at bottom of printed page
- remove the large bottom margin previously set for body (180px)
- rely on @page bottom margin for footer space */
body {
    font-family: Arial, sans-serif;
    /* margin: 0px 0px 10px; */
    margin: 0;
    counter-reset: page;
    background-color: unset !important;
}

/* encourage tables not to be split awkwardly */
table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    page-break-inside: auto;
}

header {
    text-align: center;
    font-size: 85%;
    margin-bottom: 10px;
    position: relative;
    top: -20px;
}

header *,
header p {
    line-height: 1;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
}

th,
td {
    border: 1px solid #ccc;
    padding: 8px;
    vertical-align: top;
}

th {
    background: #f2f2f2;
}

section {
    margin-bottom: 20px;
}

section h1 {
    /* margin-bottom: 0; */
}

section hr {
    margin-top: 0;
}

/* :not(.container) .form-section { margin: 0 40px 0;} */
