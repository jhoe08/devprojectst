}

.text-italic {
    font-style: italic;
}

.mt-0 {
    margin-top: 0
}

.mb-0 {
    margin-bottom: 0
}

.fw-normal {
    font-weight: normal;
}

.text-center {
    text-align: center;
}

.top-logo {
    display: none;
    visibility: hidden;
    position: absolute;
    top: 15px;
    left: -85px;
    display: flex;
    align-items: flex-start;
