<% 
    const [purchaseRequest, purchaseOrder, isWinner, supplierDetails]=results; 
    if (!results) return; 
    var status;
    const { bid_notice_title }=purchaseRequest[0];
    
    const { transaction_id, quoted_price }=isWinner[0];
    const { supplier_code, supplier_name, contact_person, address }=supplierDetails[0];

    if (purchaseOrder.length > 0) {
       status=purchaseOrder[0].status;
    }
    %>
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5><b>
                                    Purchase Order #
                                </b></h5>
                            <p class="text-muted">
                               <%= bid_notice_title %>
                            </p>
                        </div>
                        <h3 class="text-warning fw-bold">
                            <%= UTILS.generatePOCode(transaction_id) %>
                        </h3>
                    </div>
                    <div class="separator-solid mt-0"></div>
                    <div class="d-flex justify-content-between mt-2">
                        <p class="text-muted mb-0">Status</p>
                        <p class="text-muted mb-0 text-warning text-capitalize"><%= status ?? 'Unknown' %></p>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5><b><%= supplier_name %></b></h5>
                            <p class="text-muted"><%= address %></p>
                        </div>
                        <h3 class="text-info fw-bold">
                            <%= UTILS.peso(quoted_price) %>
                        </h3>
                    </div>
                    <div class="progress progress-sm">
                        <div class="progress-bar bg-info w-25" role="progressbar" aria-valuenow="75"
                            aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <p class="text-muted mb-0">Status</p>
                        <p class="text-muted mb-0">25%</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <div class="card-title">Details
                        </div>
                        <div class="card-tools">
                            <button id="refreshTransactions"
                                class="btn btn-icon btn-link btn-primary btn-xs btn-refresh-card"
                                data-component="transactions">
                                <span class="fa fa-sync-alt"></span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <form id="purchaseOrderForm" action="/purchaseOrders/create" method="POST" class="row g-3">
                        <input type="hidden" name="pr_id" value="<%= transaction_id %>">
                        <input type="hidden" name="supplier_code" value="<%= supplier_code %>">
                        <input type="hidden" name="po_number" value="<%= UTILS.generatePOCode(transaction_id) %>">
                        <input type="hidden" name="total_amount" value="<%= quoted_price %>">
                        <input type="hidden" name="status" value="Progress">
                        <!-- List of Products -->
                        <div id="productList"></div>
                        <!-- Submit -->
                        <div class="col-12">
                            <button id="addProductBtn" type="button" class="btn btn-primary btn-border">Add New Product</button>
                            <button id="submitBtn" type="submit" class="btn btn-primary">Create Purchase Order</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <template id="addNewProductTemplate">
        <div class="product-entry card mb-2 p-2">
            <div class="row">
                <div class="col-md-11">
                    <div class="form-row align-items-end row">

                        <!-- Product ID (foreign key) -->
                        <div class="col-md-12 d-flex">
                            <div class="form-group form-group-default">
                                <label for="product" class="form-label">Product</label>
                                <textarea id="product" name="product" class="product form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <!-- Unit -->
                        <div class="col-md-4">
                            <div class="form-group form-group-default">
                                <label for="unit" class="form-label">Unit</label>
                                <input type="text" id="unit" name="unit" class="unit form-control" required>
                            </div>
                        </div>

                        <!-- Quantity -->
                        <div class="col-md-4">
                            <div class="form-group form-group-default">
                                <label for="quantity" class="form-label">Quantity</label>
                                <input type="number" id="quantity" name="quantity" class="quantity form-control" min="1"
                                    required>
                            </div>
                        </div>

                        <!-- Unit Price -->
                        <div class="col-md-4">
                            <div class="form-group form-group-default">
                                <label for="unit_price" class="form-label">Unit Price</label>
                                <input type="number" id="unit_price" name="unit_price" 
                                    class="unit-price form-control"
                                    step="0.01" required>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="button" class="remove-product-btn btn btn-danger btn-border"
                        style="height: stretch;margin-bottom: 15px;"><i class="fas fa-times"></i></button>
                </div>
            </div>
        </div>
    </template>