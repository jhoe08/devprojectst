<div class="card">
    <div class="card-header">
        <div class="card-head-row card-tools-still-right">
            <div class="card-title">List of <%=title%>
            </div>
            <div class="card-tools">
                <button id="refreshTransactions" class="btn btn-icon btn-link btn-primary btn-xs btn-refresh-card"
                    data-component="transactions">
                    <span class="fa fa-sync-alt"></span>
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <%- include('../../components/datatables/tables', { 
          tableId: "disbursementVouchers", 
          classes: "transactionsTables",
          thead: [...Object.keys(_datatables[0] || {}), "refno", "actions"], 
          tbody: _datatables?.map(txn => ({
                ...txn,
                product_id: UTILS.generatePRCode(txn),
                approved_budget: UTILS.peso(txn.approved_budget),
                pr_date: moment(txn.pr_date).format('LL'),
                bid_notice_title: UTILS.progressBar(txn),
                refNo: txn.product_id,
                actions: `
                    <div class="form-button-action" data-transid="2">
                        <span data-bs-toggle="tooltip" aria-label="View Transactions" data-bs-original-title="View Transactions">
                            <a href="/transactions/${txn.product_id}/view" data-transid="${txn.product_id}" type="button" class="btn btn-link btn-primary">
                                <i class="fa fa-eye"></i>
                            </a>
                        </span>
                        <span class="hidden" data-bs-toggle="tooltip" aria-label="Prepare Check" data-bs-original-title="Prepare Check">
                            <a id="viewPage" href="/checkPayments/${txn.product_id}/view" data-voucher="${UTILS.generateDVCode(txn.product_id)}" type="button" class="btn btn-link btn-danger">
                                <i class="fas fa-hashtag"></i>
                            </a>
                        </span>
                    </div>
                `
            })), 
          hideColumns: [] 
        }) %>
    </div>
</div>