<% %>

    <form id="marketScopeForm" class="card">
        <section aria-labelledby="context">
            <p>
                This confirms that market scoping activities were conducted in accordance with Section 10 of Republic
                Act
                No. 12009
                and its Implementing Rules and Regulations (IRR), and considered in the Project Procurement Management
                Plan,
                consistent with the Principle of Proportionality.
            </p>

            <div class="grid">
                <div>
                    <label for="projectTitle">Project title</label>
                    <input id="projectTitle" name="projectTitle" type="text"
                        placeholder="e.g., Procurement of ICT Equipment FY2026" />
                </div>
                <div>
                    <label for="estimatedBudget">Estimated Budget</label>
                    <input id="estimatedBudget" name="estimatedBudget" type="text" placeholder="e.g., 100,000,000.00" />
                </div>
                <div>
                    <label for="endUser">End-user / implementing unit</label>
                    <input id="endUser" name="endUser" type="text" placeholder="e.g., ICT Unit, RFO VII" />
                </div>
                <div>
                    <label for="periodOfMarketScoping">Period of Market Scoping</label>
                    <input id="periodOfMarketScoping" name="periodOfMarketScoping" type="text"
                        placeholder="e.g., January - February, 2026" />
                </div>
                <div>
                    <label for="expectedDateOfDelivery">Expected date of Delivery</label>
                    <input id="expectedDateOfDelivery" name="expectedDateOfDelivery" type="date"
                        placeholder="e.g., January 2026" />
                </div>
            </div>
        </section>

        <section aria-labelledby="activities">
            <table aria-label="Market scoping activities">
                <thead>
                    <tr>
                        <th style="width: 110px;">Check (✓)</th>
                        <th style="width: 38%;">Activity/ies conducted</th>
                        <th>Documentation (as may be applicable)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="checkbox" id="a1" name="activity_consultations" /></td>
                        <td><label for="a1">Consultations with suppliers / contractors / consultants / professional
                                associations or industry groups</label></td>
                        <td>
                            Highlights of consultations or meetings; proof of attendance; reports; summaries;
                            screenshots;
                            brochures; publications; price quotations; canvass sheets; Market Analysis Report or similar
                            documents
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" id="a2" name="activity_summits" /></td>
                        <td><label for="a2">Participation in summits, fora, or conferences</label></td>
                        <td>Highlights of consultations or meetings; proof of attendance; reports</td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" id="a3" name="activity_reports" /></td>
                        <td><label for="a3">Review of technical, financial, or market/scientific reports</label></td>
                        <td>Reports; summaries; screenshots; brochures; publications; Market Analysis Report or similar
                            document; online product reviews</td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" id="a4" name="activity_brochures" /></td>
                        <td><label for="a4">Review of product/service brochures, marketing materials, industry
                                journals/publications, or related materials</label></td>
                        <td>Reports; summaries; screenshots; brochures; publications; online product reviews</td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" id="a5" name="activity_price_sourcing" /></td>
                        <td><label for="a5">Price sourcing for quotations or cost estimates from suppliers, contractors,
                                or
                                consultants</label></td>
                        <td>Price quotations; canvass sheets; online product reviews</td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" id="a6" name="activity_philgeps" /></td>
                        <td><label for="a6">Use of data from PhilGEPS or agency websites</label></td>
                        <td>Reports; summaries; screenshots; price quotations; canvass sheets; PhilGEPS postings; online
                            product reviews</td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" id="a7" name="activity_other" /></td>
                        <td><label for="a7">Other analogous market scoping activity/ies undertaken</label></td>
                        <td>
                            <textarea name="other_docs"
                                placeholder="Describe the activity and attach or list documentation (e.g., links, file names, references)"></textarea>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>
        <section id="supplier-quotations" class="notes supplier-quotations" style="display: none;">
            <strong>Supplier Quotations</strong>
            <table id="quotations-table">
                <thead>
                    <tr>
                        <th>Supplier Name</th>
                        <th>Quoted Amount (₱)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Rows will be added dynamically -->
                </tbody>
            </table>
            <button class="btn btn-info mt-3" type="button" onclick="addQuotationRow()">Add Supplier</button>
        </section>
        <section class="notes" aria-labelledby="notes">
            <strong>Notes:</strong>
            <ul>
                <li>The market scoping activities shall be identified and undertaken at the option of the End-User or
                    Implementing Unit based on its needs and objectives.</li>
                <li>The list of supporting documents in the Documentation column is not exclusive and may include other
                    documents that may be gathered by the End-User or Implementing Unit pertinent to the activity/ies
                    conducted.</li>
            </ul>
        </section>

        <section class="footer-grid" aria-labelledby="signatures">
            <div class="sig">
                <label for="preparedBy">Prepared by</label>
                <input data-dialog="false" data-type="employees" data-show="firstname, lastname, experience"
                    id="preparedBy" name="preparedBy" type="text" placeholder="Name, Position" readonly />
                <div class="grid" style="margin-top:8px;">
                    <div>
                        <label for="preparedDate">Date</label>
                        <input id="preparedDate" name="preparedDate" type="date" value="<%= moment() %>" />
                    </div>
                    <div>
                        <label for="preparedSignature">Signature/Initials</label>
                        <input id="preparedSignature" name="preparedSignature" type="text"
                            placeholder="Initials or signature reference" />
                    </div>
                </div>
            </div>
            <div class="sig">
                <label for="reviewedBy">Reviewed/validated by</label>
                <input id="reviewedBy" name="reviewedBy" type="text" placeholder="Name, Position" readonly />
                <div class="grid" style="margin-top:8px;">
                    <div>
                        <label for="reviewedDate">Date</label>
                        <input id="reviewedDate" name="reviewedDate" type="date" />
                    </div>
                    <div>
                        <label for="reviewedSignature">Signature/Initials</label>
                        <input id="reviewedSignature" name="reviewedSignature" type="text"
                            placeholder="Initials or signature reference" />
                    </div>
                </div>
            </div>
        </section>

        <div class="actions align-items-center">
            <button type="submit" class="btn btn-primary">Confirm</button>
            <button type="reset" class="btn">Clear</button>
            <span class="muted">Save or print after completing fields and checking applicable activities.</span>
        </div>
    </form>

    <script>

        document.querySelector("input[name='activity_price_sourcing']").addEventListener("change", function () {
            const section = document.getElementById("supplier-quotations");
            if (this.checked) {
                section.style.display = "block"; // show
            } else {
                section.style.display = "none";  // hide
            }
        });

        const SUPPLIERS = <%- JSON.stringify(SUPPLIERS) %>;

        function addQuotationRow(selectedSupplier = "", amount = "") {
            const tbody = document.querySelector("#quotations-table tbody");
            const row = document.createElement("tr");

            // Build options dynamically
            const optionsHtml = SUPPLIERS.map(supplier => {
                const { supplier_name, supplier_code } = supplier;
                return `<option value="${supplier_code}" ${supplier_code === selectedSupplier ? "selected" : ""}>${supplier_name}</option>`
            }).join("");


            row.innerHTML = `
            <td><div class="form-group form-group-default form-group-select">
                <label class="hidden" for="prClassification">Classification</label>
                <select id="_suppliers" name="_suppliers" class="form-select" data-selected="Others" data-division="Others">
                    ${optionsHtml}
                </select>
            </div>
                </td>
            <td><input type="number" class="form-control" name="supplier_amount" value="${amount}" placeholder="Amount"></td>
            <td><button class="btn btn-danger" type="button" onclick="this.closest('tr').remove()"><i class="fa fa-trash"></i> Remove</button></td>
        `;

            tbody.appendChild(row);
        }

        // Example: populate from JSON
        function populateQuotations(quotations) {
            quotations.forEach(q => addQuotationRow(q.supplier, q.amount));
        }

        // Example JSON data
        const results = {
            supplier_quotations: [
                // { supplier: "Supplier A", amount: 50000 },
                // { supplier: "Supplier B", amount: 52000 }
            ]
        };

        // Populate on page load
        document.addEventListener("DOMContentLoaded", () => {
            populateQuotations(results.supplier_quotations);
        });
    </script>