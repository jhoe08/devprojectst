<div class="card">
  <div class="card-header">
    <div class="card-head-row card-tools-still-right">
      <div class="card-title">List of <%=title%>
      </div>
    </div>
  </div>
  <div class="card-body">
  <% if (datatables && datatables.length > 0) { %>
    <%- include('../../components/datatables/tables', { 
          tableId: "marketScope", 
          thead: Object.keys(datatables[0] || {}), 
          tbody: datatables, 
          hideColumns: [] 
        }) %>
  <% } else { %>
    <p class="text-danger">Server error detected. For resolution, please contact your system developer.</p>
  <% } %>
  </div>
</div>