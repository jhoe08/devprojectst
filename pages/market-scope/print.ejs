<%
    const { id:parentId, project_title, reference_number, date_conducted, end_user_unit, consultations_with_suppliers, participation_in_summits, review_reports, review_brochures, price_sourcing, use_philgeps_data, other_activity, documentation, prepared_by_name, prepared_by_position, prepared_by_date, prepared_by_signature, reviewed_by_name, reviewed_by_position, reviewed_by_date, reviewed_by_signature } = results[0] || {}
    
    const { scoping_id:refId, results:scopingResults, document_reference, created_at, updated_at } = results[1] || {}
    
    const { project_cost, project_design, technical_criteria, delivery_leadtime, storage, risks } = (scopingResults && scopingResults !== "undefined") ? JSON.parse(scopingResults) : {}
%>

<style>
    @page {
        margin: 0mm 0mm 25mm;
        @bottom-left {
            content: "Page " counter(page) " of " counter(pages) " | Market Scoping Checklist";
            margin-left: 10mm;
        }
        /* @bottom-center {
            content: "Page " counter(page) " of " counter(pages) " | Market Scoping Checklist";
        }
        @bottom-right {
            content: "Page " counter(page) " of " counter(pages) " | Market Scoping Checklist";
        } */
    }

    /* First-page background/header for print only.
    Replace 'header-bg.png' with your image path or remove background-image to use color only. */
    @page :first {
        background: url('/client/assets/img/da-background.png') no-repeat left top;
        background-size: contain;
        background-position: 10px 10px;
    }

    :root {
        --pagedjs-margin-top: 0.5in !important;
        --pagedjs-margin-bottom: 1in !important;
    }

    .page-break {
        page-break-before: always;
    }

    /* avoid leaving large blank space at bottom of printed page
    - remove the large bottom margin previously set for body (180px)
    - rely on @page bottom margin for footer space */
    body {
        font-family: Arial, sans-serif;
        margin: 0px 0px 10px;
        counter-reset: page;
        background-color: unset !important;
    }

    /* encourage tables not to be split awkwardly */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        page-break-inside: auto;
    }

    header {
        text-align: center;
        font-size: 85%;
        margin-bottom: 10px;
        position: relative;
        top: -20px;
    }

    header *,
    header p {
        line-height: 1;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

    th,
    td {
        border: 1px solid #ccc;
        padding: 8px;
        vertical-align: top;
    }

    th {
        background: #f2f2f2;
    }

    section {
        margin-bottom: 20px;
    }

    section h1 {
        margin-bottom: 0;
    }

    section hr {
        margin-top: 0;
    }

    /* :not(.container) .form-section { margin: 0 40px 0;} */
    .form-section strong {
        display: block;
        margin-bottom: 8px;
    }

    .w-50 {
        width: 50%;
    }

    .w-41 {
        width: 41.66666667%;
    }

    .w-16 {
        width: 16.66666667%;
    }

    .d-flex {
        display: flex;
    }

    .text-uppercase {
        text-transform: uppercase;
    }

    .text-lowercase {
        text-transform: lowercase;
    }

    .text-normal {
        text-transform: none;
    }

    .text-italic {
        font-style: italic;
    }

    .mt-0 {
        margin-top: 0
    }

    .mb-0 {
        margin-bottom: 0
    }

    .fw-normal {
        font-weight: normal;
    }

    .text-center {
        text-align: center;
    }

    .top-logo {
        position: absolute;
        top: 15px;
        left: -85px;
        display: flex;
        align-items: flex-start;
    }

    .top-logo img {
        width: 80px;
    }

    .top-logo img.daLogo {
        width: 120px;
        position: relative;
        left: -10px;
        top: -13px;
    }

    .page-inner {
        padding: 0 !important;
    }

    .main-header {
        min-height: 10px;
    }

    @media print {
        #print-area,
        #print-area *{
            visibility: visible !important;
            overflow: visible !important;
        }

        
    }
</style>

