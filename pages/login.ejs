<!-- Header Template -->
<%- include('../views/header') -%>
<link rel="stylesheet" href="./assets/css/login.css">
<div class="container-fluid">
    <div class="row">
      <div class="col-sm-6 col-md-7 intro-section">
        <div class="brand-wrapper d-flex flex-row align-items-center">
          <img src="./assets/img/da-logo.png" alt="Department of Agriculture" />
          <div class="brand-text">
            <h6 class="text-black">Republic of the Philippines</h6>
            <h1 class="text-secondary">Department of Agriculture</h1>
            <h2 class="text-black">Regional Field Office 7</h2>
          </div>
        </div>
        <div class="intro-content-wrapper">
          <h1 class="intro-title">"Masaganang Agrikultura, Maunlad na Ekonomiya"</h1>
          <div>
            <p class="intro-text">We hope to attract a new generation of farmers, researchers, and innovators who will ensure the country's food security in the years to come. Together, let us fulfill our shared dream of a strong, prosperous, and food secure Philippines.</p>
            <div class="d-flex align-items-center mb-4">
              <div class="avatar avatar-xl mr-1">
                <img src="./assets/img/undersec_laurel.webp" alt="..." class="avatar-img rounded-circle">
              </div>
              <p class="mb-0">Francisco Tiu Laurel Jr.<br><em>Secretary</em></p>
            </div>
            
          </div>
          
          <a href="https://rfo7.da.gov.ph/" class="btn btn-read-more">Read more</a>
        </div>
        <div class="intro-section-footer">
          <na class="footer-nav">
            <a href="https://www.facebook.com/DA7centralvisayas">Facebook</a>
            <a href="https://www.youtube.com/channel/UCvCFEdZcat3Nq_Ep1CfPjnQ/featured">Youtube</a>
            <a href="mailto:rafisvii2014@gmail.com">Email</a>
          </na>
        </div>
      </div>
      <div class="col-sm-6 col-md-5 form-section">
        <div class="login-wrapper">
          <h2 class="login-title">Sign in</h2>
          <form action="/login" method="post">
            <div class="form-floating form-floating-custom mb-3">
              <input type="text" class="form-control" name="username" id="floatingUsernameInput">
              <label for="floatingUsernameInput">Username</label>
            </div>
            <div class="form-floating form-floating-custom mb-3">
              <input type="password" class="form-control" name="password"  id="floatingPasswordInput">
              <label for="floatingPasswordInput">Password</label>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-5">
              <input name="login" id="login" class="btn login-btn" type="submit" value="Login">
              <a href="#!" class="forgot-password-link">Password?</a>
            </div>
          </form>
          <div class="form-group mt-3 text-center">
            <a href="/token?guest_token=<%= guestToken || '' %>" class="btn btn-outline-primary" onclick="submitGuestToken()">
              Continue as Guest
            </a>
            <form id="guestForm" method="POST" action="/login">
              <input type="hidden" name="guest_token" value="<%= guestToken || '' %>">
            </form>

          </div>
          <p class="login-wrapper-footer-text">Need an account? <a href="/register" class="text-reset">Signup here</a></p>
        </div>
      </div>
    </div>
  </div>

<!-- Footer Template -->

<%- include('../views/footer') -%>