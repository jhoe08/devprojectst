<% 
    const [target, documentationOptions] = data
%>
<div class="form-group p-0">
  <div class="selectgroup selectgroup-pills">
    <% documentationOptions.forEach(function(opt) { %>
      <label class="selectgroup-item">
        <input type="checkbox" name="value" value="<%= opt %>" class="selectgroup-input">
        <span class="selectgroup-button"><%= opt %></span>
      </label>
    <% }); %>
  </div>
</div>
