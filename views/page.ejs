<% 
  const hideTitle=(typeof options !=="undefined" && options.hideTitle) ? options.hideTitle : false; 
  const hideFooter=(typeof options !=="undefined" && options.hideFooter) ? !options.hideFooter : true;
  const _mode = (typeof mode !=="undefined" && mode) ? mode : null;


  let isNewRecord = false;
  if (_mode === 'create' || _mode === 'register') {
    isNewRecord = true;
  }
%>

<%- include('header') -%>
  <div class="wrapper" data-template="<%= PROCUREMENT.currentLaw %>">
    <%- include('sidebar') -%>
      <div class="main-panel">
        <%- include('../views/main-header') -%>
          <div class="container">
            <div class="page-inner">
              <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
                
                  <% if (!hideTitle) { %>
                    <div>
                      <h3 class="fw-bold mb-3"><%- title -%></h3>
                      <%- description ? '<h6 class="op-7 mb-2">' + description + '</h6>' : '' %>
                    </div>
                  <% const button=(typeof options !=="undefined" && options.buttons) 
                      ? ((!isNewRecord) 
                        ? options.buttons[0] 
                        : options.buttons[1]) 
                      : false ; %>
                    <% if(button) { %>
                      <div class="ms-md-auto py-2 py-md-0">
                        <a id="<%= button.id %>" href="#" class="btn btn-primary btn-round">
                          <i class="fas <%= button.icon %>"></i>
                          <%= button.title %>
                        </a>
                      </div>
                    <% } %>
                  <% } %>
              </div>
              <div class="row">
                <%- include(innerContent) -%>
              </div>
            </div>
          </div>
          
          <% if (!hideFooter) { %>
          <footer class="footer">
            <div class="container-fluid d-flex justify-content-between">
              <nav class="pull-left">
                <ul class="nav">
                  <li class="nav-item">
                    v2.2.2
                  </li>
                </ul>
              </nav>
              <div class="copyright">
                <%= moment().format('YYYY') %>, made with <i class="fa fa-heart heart text-danger"></i> by
                <a href="http://www.themekita.com">ThemeKita</a>
              </div>
            </div>
          </footer>
          <% } %>
      </div>
  </div>
  

  <%- include('footer', { scripts }) -%>