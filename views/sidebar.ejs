<%
  const {transactions, totalTransactions, employees, market_scopes} = SUMMARY || {}
  const { row_count:total_transactions } = JSON.parse(transactions || '{}')
  const { row_count:total_employees } = JSON.parse(employees || '{}')
  const { row_count:total_market_scopes } = JSON.parse(market_scopes || '{}')
%>

<%
  const menuItems = [
    {
      label: "Dashboard",
      icon: "fas fa-home",
      path: "/",
      show: true
    },
    {
      label: "Market Scope",
      icon: "fas fa-compass",
      path: "/market-scope",
      collapseId: "market-scope",
      show: PROCUREMENT.currentLaw === 'RA120092025',
      children: [
        { label: "Lists", path: "/market-scope", badge: total_market_scopes },
        { label: "Add New", path: "/market-scope/new" },
        { label: "Analytics", path: "/404" }
      ]
    },
    {
      label: "Allocated Funds",
      icon: "fas fa-money",
      path: "/allocated-funds",
      collapseId: "market-scope",
      show: PROCUREMENT.currentLaw === 'RA120092025',
      children: [

        { label: "Lists", path: "/market-scope", badge: total_market_scopes },
        { label: "Add New", path: "/market-scope/new" },
        { label: "Analytics", path: "/404" }
      ]
    },
    
    {
      label: "Scan QR Code",
      icon: "fas fa-qrcode",
      path: "/qrscanner",
      show: !isGuest()
    },
    {
      section: "Transactions",
      show: userAvailComponents("Transactions"),
      children: [
        { label: "Lists", path: "/transactions", icon: "fas fa-file", badge: totalTransactions },
        { label: "Add New", path: "/transactions/new", icon: "fas fa-plus", show: !isGuest() && PROCUREMENT.currentLaw !== 'RA120092025' },
      ]
    },
    {
      section: "Suppliers",
      show: userAvailComponents("Transactions"),
      children: [
        { label: "Lists", path: "/suppliers", icon: "fas fa-truck" },
        { label: "Scan QRCode", path: "/transactions/scan", icon: "fas fa-qrcode", hidden: true }
      ]
    },
    {
      section: "Employees",
      show: userAvailComponents("Employees"),
      children: [
        { label: "Lists", path: "/employees", icon: "fas fa-user-friends", badge: total_employees },
        { label: "Add New", path: "/employees/new", icon: "fas fa-user-plus", show: ENVIRONMENT === "testing" },
        { label: "Register", path: "/employees/register", icon: "fas fa-upload", show: !hasAllowedRole(["Contributor","Viewer"]) }
      ]
    },
    {
      section: "Inventory",
      hidden: true,
      children: [
        { label: "Dashboard", path: "/inventory", icon: "fas fa-warehouse", hidden: true }
      ]
    },
    {
      section: "Documents",
      show: !isGuest() && userAvailComponents("Documents"),
      children: [
        { label: "Media", path: "/media", icon: "fas fa-file-image" },
        { label: "Lists", path: "/documents", icon: "fas fa-copy" }
      ]
    }
  ];
%>

<div class="sidebar" data-background-color="white">
  <div class="sidebar-logo">
    <div class="logo-header" data-background-color="green2">
      <a href="/" class="logo">
        <img src="/assets/img/da-logo-circle.png" alt="navbar brand" class="navbar-brand mr-3" height="20" />
        D.A RFO7
      </a>
      <div class="nav-toggle">
        <button class="btn btn-toggle toggle-sidebar"><i class="gg-menu-right"></i></button>
        <button class="btn btn-toggle sidenav-toggler"><i class="gg-menu-left"></i></button>
      </div>
      <button class="topbar-toggler more"><i class="gg-more-vertical-alt"></i></button>
    </div>
  </div>
  <div class="sidebar-wrapper scrollbar scrollbar-inner">
    <div class="sidebar-content">
      <ul class="nav nav-secondary" data-current-url="<%- path -%>">
        <% menuItems.forEach(item => {
             if(item.show === false) return;
             if(item.section) { %>
               <li class="nav-section <%= item.hidden ? 'hidden' : '' %>">
                 <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                 <h4 class="text-section"><%= item.section %></h4>
               </li>
               <% if(item.children) { item.children.forEach(child => {
                    if(child.show === false) return; %>
                    <li class="nav-item <%= UTILS.isActive(currentPath, child.path) %> <%= child.hidden ? 'hidden' : '' %>">
                      <a href="<%= child.path %>">
                        <i class="<%= child.icon %>"></i>
                        <p><%= child.label %>
                          <% if(child.badge) { %>
                            <span class="badge badge-secondary pull-right"><%= child.badge %></span>
                          <% } %>
                        </p>
                      </a>
                    </li>
               <% }) } %>
             <% } else if(item.children) { %>
               <li class="nav-item <%= UTILS.isActive(currentPath, item.path) %>">
                 <a data-bs-toggle="collapse" href="#<%= item.collapseId %>">
                   <i class="<%= item.icon %>"></i>
                   <p><%= item.label %></p>
                   <span class="caret"></span>
                 </a>
                 <div class="collapse" id="<%= item.collapseId %>">
                   <ul class="nav nav-collapse">
                     <% item.children.forEach(child => { %>
                       <li>
                         <a href="<%= child.path %>">
                           <span class="sub-item"><%= child.label %>
                             <% if(child.badge) { %>
                               <span class="badge badge-secondary pull-right"><%= child.badge %></span>
                             <% } %>
                           </span>
                         </a>
                       </li>
                     <% }) %>
                   </ul>
                 </div>
               </li>
             <% } else { %>
               <li class="nav-item <%= UTILS.isActive(currentPath, item.path) %>">
                 <a href="<%= item.path %>">
                   <i class="<%= item.icon %>"></i>
                   <p><%= item.label %>
                     <% if(item.badge) { %>
                       <span class="badge badge-secondary pull-right"><%= item.badge %></span>
                     <% } %>
                   </p>
                 </a>
               </li>
             <% } %>
        <% }) %>
      </ul>
    </div>
  </div>
</div>