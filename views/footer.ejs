    <% if (typeof scripts !== 'undefined' && scripts) { 
        const extractedScripts = Object.entries(scripts).map(([title, source]) => ({ title, source }));
        extractedScripts.forEach(({ title, source }) => { %>
          <% if (source.includes('/vendor')) { %>
            <script title="<%= title || source %>" src="<%= source %>"></script>
          <% } else { %>
            <script type="module" title="<%= title || source %>" src="<%= source %>"></script>
          <% } %>
    <%   }); 
      } %>


