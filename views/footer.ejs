    for (let i = 0; i < nestedSortables.length; i++) {
      new Sortable(nestedSortables[i], {
        group: 'nested',
        animation: 150,
        fallbackOnBody: true,
        swapThreshold: 0.65
      });
    }

    const sortableSection = document.querySelectorAll('.nested-sortable');
    for (let i = 0; i < sortableSection.length; i++) {
